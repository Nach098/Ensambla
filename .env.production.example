# Copiar a .env.production y completar en el servidor, fuera de Git.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
APP_ORIGIN=https://REEMPLAZAR_DOMINIO
DATABASE_URL=postgresql://REEMPLAZAR_USUARIO:REEMPLAZAR_PASSWORD@REEMPLAZAR_HOST:5432/ensambla?sslmode=verify-full
TRUST_PROXY=true
# compose.production.yaml expone sólo localhost, detrás de un proxy HTTPS.
APP_PORT=3000
ENSAMBLA_IMAGE=ensambla:REEMPLAZAR_COMMIT
