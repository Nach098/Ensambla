{
  "name": "ensambla",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch backend/src/server.ts",
    "build": "npm run build --workspace @ensambla/backend",
    "start": "node --env-file-if-exists=.env backend/dist/server.js",
    "check": "npm run check --workspaces",
    "test": "npm run test --workspaces",
    "db:migrate": "node --env-file-if-exists=.env --import tsx backend/src/database/cli.ts",
    "db:migrate:production": "node --env-file-if-exists=.env backend/dist/database/cli.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:cleanup-auth": "node --env-file-if-exists=.env --import tsx backend/src/database/cleanup-auth.ts",
    "db:cleanup-auth:production": "node --env-file-if-exists=.env backend/dist/database/cleanup-auth.js"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  },
  "description": "Comandos y espacios de trabajo del proyecto Ensambla."
}
